# ---------------------------------------------------------------------------
# PRISMT .gitignore
#
# Rule of thumb: user data, run outputs and environments are never committed.
# Small files that are part of the package (test fixtures, the atlas asset)
# are re-included at the bottom. Do not name fixture folders "runs", "logs",
# "artifacts" or "results": a directory pattern here cannot be re-included.
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.venv*/
venv/

# OS and editors
.DS_Store
Thumbs.db
*.asv
*~
.vscode/
.idea/

# Data and run outputs
*.mat
*.h5
*.hdf5
*.npy
*.npz
*.pt
*.pth
*.journal
*.db
*.partial
runs/
prismt_runs/
hpo_runs/
artifacts/
generated_scripts/
wandb/
logs/
tests/matlab/results/

# Scratch material that is not part of the package
docs/audit-screenshots/

# Re-include small files that are part of the package
!tests/fixtures/**
!matlab/+prismt/+atlas/private/*.mat
